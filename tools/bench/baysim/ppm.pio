; PPM pulse train, two FIFO words per pulse: the pulse length, then the
; space after it, in cycles (1/8 us), less the program's own cycles:
; pulse - 2, space - 6. The pin high for the pulse (the GPIO override
; inverts it for negative PPM)
.program ppm
.wrap_target
    pull block
    mov y, osr
    pull block
    mov x, osr
    set pins, 1
pulse:
    jmp y-- pulse
    set pins, 0
space:
    jmp x-- space
.wrap
